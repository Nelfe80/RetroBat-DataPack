        { address=0X0F20, type="u8", condition="change", action="SPEED_TIMER", no_log=true, desc="P-Meter max speed" },
        { address=0X0F20, type="u8", condition="eq", value=0X7F, action="SPEED_START", desc="P-meter fully charged" },
        { address=0X1490, type="u8", condition="increase", action="INVINCIBILITY_START", desc="Starman power-up timer started" },
        { address=0X1490, type="u8", condition="decrease", action="INVINCIBILITY_STOP", desc="Starman power-up timer ended" },
      },
    },
  },
}

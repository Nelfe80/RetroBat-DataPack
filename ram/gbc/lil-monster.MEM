        { address=0XD1C0, type="u8", condition="change", action="COMBO_TIMER", timer_kind="game", timer_role="combo", timer_direction="unknown", timer_unit="unknown", no_log=true, desc="[8 Bit] Fourth Gem in Hand During Battle. Sets to FF after being used." },
        { address=0XD1D4, type="u8", condition="change", action="COMBO_TIMER", timer_kind="game", timer_role="combo", timer_direction="unknown", timer_unit="unknown", no_log=true, desc="[8 Bit] Player Gem used in battle" },
        { address=0XD622, type="u16le", condition="change", action="GENERAL_TIMER", timer_kind="game", timer_role="unknown", timer_direction="unknown", timer_unit="unknown", desc="[16 Bit] Player Monster Weight," },
        { address=0XD6E4, type="u8", condition="change", action="GENERAL_TIMER", timer_kind="game", timer_role="unknown", timer_direction="unknown", timer_unit="unknown", desc="[8 Bit] Number of times player has pulled the GemChip covered in Thorns." },
        { address=0XD72E, type="u16le", condition="change", action="LEVEL_TIMER", timer_kind="game", timer_role="level", timer_direction="elapsed", timer_unit="second", desc="[16 Bit] Play Time (first two digits are minutes, second two digits are hours)" },
      },
    },
  },
}

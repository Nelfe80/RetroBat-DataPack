    resources = {
      -- Le continue (labo MAME du 2026-10-09, cartouche 3d9a8d5c) : a l'ecran Game Over, Haut tenu et
      -- huit appuis sur le bouton 2 relancent la partie contre 400 baums, au meme niveau, SCORE GARDE.
      -- 0x0057 compte les appuis et retombe de 7 a 0 au huitieme, a l'instant du continue (code du jeu
      -- en 0x6E28) ; il ne bouge qu'a cet ecran. Seuls 7 et 0 sont signales : un code tape vite ne fait
      -- jamais huit changements rapproches, et le wrapper ne rend pas la ligne muette.

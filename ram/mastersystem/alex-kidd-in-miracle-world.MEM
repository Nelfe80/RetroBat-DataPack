        { address=0X013C, type="u8", condition="eq", value=0X9F, action="TITLE_SCREEN", desc="Title" },
        { address=0X013C, type="u8", condition="eq", value=0XB1, action="GAME_OVER", desc="Game Over" },
      },
    },

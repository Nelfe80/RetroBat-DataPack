  events = {
    flow = {
      lifecycle = {
        -- 0x001F porte l'etat dans ses 7 bits bas ; le bit 7 s'allume la plupart du temps (mesure sous
        -- MAME le 2026-09-29 : 0x80 au titre, 0x83 intro de niveau, 0x8A en jeu, 0x8B en pause). Chaque
        -- etat se lit donc sous ses deux formes.
        { address=0X001F, type="u8", condition="eq", value=0X0, action="TITLE_SCREEN", desc="title" },
        { address=0X001F, type="u8", condition="eq", value=0X80, action="TITLE_SCREEN", desc="title (bit 7)" },
        { address=0X001F, type="u8", condition="eq", value=0X1, action="TITLE_SCREEN", desc="title (interrupted demo)" },
        { address=0X001F, type="u8", condition="eq", value=0X81, action="TITLE_SCREEN", desc="title (interrupted demo, bit 7)" },
        { address=0X001F, type="u8", condition="eq", value=0X2, action="DEMO_MODE", desc="demo" },
        { address=0X001F, type="u8", condition="eq", value=0X82, action="DEMO_MODE", desc="demo (bit 7)" },
        { address=0X001F, type="u8", condition="eq", value=0XA, action="GAME_PLAYING", desc="in game" },
        { address=0X001F, type="u8", condition="eq", value=0X8A, action="GAME_PLAYING", desc="in game (bit 7)" },
        { address=0X001F, type="u8", condition="eq", value=0XB, action="PAUSE_ON", desc="paused" },
        { address=0X001F, type="u8", condition="eq", value=0X8B, action="PAUSE_ON", desc="paused (bit 7)" },

-- Sonic the Hedgehog 2 : le SENS des lignes de sonic-the-hedgehog-2.MEM lues par le Player Deck speedrun (pattern F).
-- Lu par APIExpose et le PlayerDeck seulement. Ne declare aucune adresse : chaque signal cite des lignes du .MEM.
-- N'entre ni dans le score ni dans l'empreinte certifiee (les reglements des epreuves epinglent le .MEM, pas ce fichier).
-- Format : .SMEM, schema 1, identifiants du vocabulaire standard.
return {
  schema = 1,
  kind = "semantics",
  version = 1,
  game = { system = "megadrive", slug = "sonic-the-hedgehog-2", title = "Sonic the Hedgehog 2" },
  mem = { file = "sonic-the-hedgehog-2.MEM" },

  signals = {
    { id = "players.1.lives", player = 1, kind = "counter", label = "Lives", short = "LIV",
      from = { { address = 0XFE13, action = "GAIN_LIFE" }, { address = 0XFE13, action = "LOSE_LIFE" } },
      min = 0, max = 99, quality = "qualified",
      proof = "3 aux etats des 18 epreuves, x 3 a l ecran" },
    { id = "area", kind = "counter", label = "Zone", short = "ZONE",
      from = { { address = 0XFE11, action = "PROGRESSION_ZONE" } },
      min = 0, max = 16, quality = "qualified",
      proof = "etats des 18 epreuves : 0 EHZ, 13 CPZ, 15 ARZ, 12 CNZ, 7 HTZ, 11 MCZ, 10 OOZ, 4 et 5 MTZ, 14 DEZ" },
    { id = "stage", kind = "counter", label = "Act", short = "ACT",
      from = { { address = 0XFE10, action = "PROGRESSION_STAGE" } },
      min = 0, max = 1, quality = "qualified",
      proof = "etats des 18 epreuves : 0 ou 1" },
    { id = "players.1.game.sonic_the_hedgehog_2.rings_taken", player = 1, kind = "counter", label = "Rings taken", short = "RINGS",
      from = { { address = 0XFEF0, action = "COIN_GAIN" } },
      min = 0, max = 999, quality = "qualified",
      proof = "0 a l entree de chaque acte (etats) ; anneaux pris depuis le chargement de l acte" },
  },
}

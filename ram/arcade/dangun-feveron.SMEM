-- Dangun Feveron : le SENS des signaux de dangun-feveron.MEM pour l'affichage.
-- Lu par APIExpose et le PlayerDeck seulement. Ne declare aucune adresse : chaque signal cite des lignes du .MEM.
-- N'entre ni dans le score ni dans l'empreinte certifiee. Preuves : mesures au banc FBNeo sans ecran.
-- Format : .SMEM, schema 1. Identifiants du vocabulaire standard du .SMEM.
return {
  schema = 1,
  kind = "semantics",
  version = 2,
  game = { system = "arcade", slug = "dangun-feveron", title = "Dangun Feveron" },
  mem = { file = "dangun-feveron.MEM" },

  signals = {
    { id = "stage", kind = "counter", label = "Stage", short = "STAGE",
      from = { { address = 0X52D8, action = "PROGRESSION_STAGE" } },
      min = 0, max = 4, quality = "qualified",
      proof = "0 au stage 1, 1 puis 2 aux stages suivants (banc, ecrans des stages 2 et 3)" },
    { id = "players.1.lives", player = 1, kind = "counter", unit = "ship", label = "Lives", short = "SHIP",
      from = { { address = 0X52C4, action = "LOSE_LIFE" }, { address = 0X52C4, action = "GAIN_LIFE" } },
      min = 0, max = 9, initial = 3, quality = "qualified",
      proof = "3 au depart, -1 par mort (deathsignal propre : 3, 2, 1, 0)" },
    { id = "players.1.bombs", player = 1, kind = "counter", unit = "bomb", label = "Bombs", short = "BOMB",
      from = { { address = 0X5A3A, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 9, initial = 3, quality = "qualified",
      proof = "3 au depart (icones B), 4 apres une prise" },

    { id = "rank", kind = "gauge", label = "Base rank", short = "RANK",
      from = { { address = 0X52C8, action = "OBJECT_INTERACTION" } },
      min = 0, max = 63, initial = 13, quality = "qualified",
      proof = "18 au depart = minimum 13 du stage 1 + 3 bombes + 2 vies en stock ; 34 au stage 2 ; la puissance posee le fait monter (18 -> 24), le jeu le recalcule ; vitesse des balles" },
    { id = "players.1.chain.count", player = 1, kind = "counter", label = "Cyborg chain", short = "CHAIN",
      from = { { address = 0X6C3C, action = "OBJECT_INTERACTION", player = 1 } },
      min = 1, max = 999, initial = 1, quality = "qualified",
      proof = "posee a 500 : chaque ennemi tue rapporte 500 au score du stage, chaque cyborg pris fait passer la chaine a 501, 502... et rapporte la nouvelle valeur ; retombe a 1 quand un cyborg s'echappe. Publiee par pas de 16 (mask)" },
    { id = "players.1.game.dangun_feveron.cyborgs_stage", player = 1, kind = "counter", label = "Cyborgs this stage", short = "CYB",
      from = { { address = 0X6C3E, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 9999, initial = 0, quality = "qualified",
      proof = "+1 par cyborg pris (le nombre sous le score), 0 au stage suivant. Publie par pas de 16 (mask)" },
    { id = "players.1.game.dangun_feveron.cyborgs_total", player = 1, kind = "counter", label = "Cyborgs collected", short = "TOTAL",
      from = { { address = 0X402A, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 65535, initial = 0, quality = "qualified",
      proof = "2 -> 532 sur trois stages quand le cumul des cyborgs pris donne 535 ; +8 pour 8 cyborgs pris. L'objet 1UP vient a 2000 (source : le jeu, guides publics). Publie par pas de 16 (mask)" },
    { id = "game.dangun_feveron.cyborgs_missed", kind = "counter", label = "Cyborgs missed", short = "MISSED",
      from = { { address = 0X5110, action = "OBJECT_INTERACTION" } },
      min = 0, max = 65535, initial = 0, quality = "qualified",
      proof = "cumul de toute la partie (0 -> 261 sur trois stages), jamais remis a 0 entre deux stages ; accelere les tirs vises. Publie par pas de 16 (mask)" },
    { id = "players.1.game.dangun_feveron.power_a", player = 1, kind = "gauge", label = "Power (first part)", short = "POW A",
      from = { { address = 0X5A40, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 5, initial = 0, quality = "qualified",
      proof = "0 -> 2 -> 4 -> 5 aux prises ; posee a 0 et 5 : tir change, rank recalcule" },
    { id = "players.1.game.dangun_feveron.power_b", player = 1, kind = "gauge", label = "Power (second part)", short = "POW B",
      from = { { address = 0X5A44, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 4, initial = 0, quality = "qualified",
      proof = "0 -> 2 -> 4 aux prises ; posee a 4 : gros tir rouge, a 0 : tir fin" },
    { id = "boss.hp", kind = "gauge", unit = "px", label = "Boss health", short = "BOSS",
      from = { { address = 0X5198, action = "OBJECT_INTERACTION" } },
      min = 0, max = 60, quality = "qualified",
      proof = "longueur de la barre BOSS en pixels, egale a la barre mesuree sur l'ecran (40 images du boss du stage 1, 39 exactes) ; 59 et 58 a l'entree des boss 1 et 2 ; reecrite par le jeu a chaque image. Publiee par pas de 4 en baisse, de 16 en hausse (mask)" },
  },
}

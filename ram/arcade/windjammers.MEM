        { address=0X1008F3, type="u8", condition="change", action="ROUND_POINTS", player=2, desc="P2 points du set, BCD" },
      },
      rounds = {
        { address=0X100872, type="u8", condition="increase", action="ROUND_WON", player=1, desc="P1 sets gagnes (un set nul en donne un a chacun)" },
        { address=0X1008F2, type="u8", condition="increase", action="ROUND_WON", player=2, desc="P2 sets gagnes (ou l'ordinateur, de ce cote)" },
        { address=0X100872, type="u8", condition="eq", value=0X02, action="MATCH_WON", player=1, desc="P1 gagne le match (deux sets)" },
        { address=0X1008F2, type="u8", condition="eq", value=0X02, action="MATCH_WON", player=2, desc="P2 gagne le match (deux sets)" },

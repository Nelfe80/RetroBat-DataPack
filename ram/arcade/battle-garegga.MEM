-- 2026-11-08 (Deck) : RANG cache de Garegga, offsets du bloc
-- FBNeo (mots 68000 en u16le). Rang = long 68000 en 0xC9D2 (0xF00000 au depart = facile, plancher 0x200000 en reglage
-- Normal ; la valeur BAISSE quand la difficulte monte). Seul le mot fort est surveille (rang >> 16, 0xF0 a 0x20) : le
-- mot faible bouge a chaque image. 0xC9D8 = rang ajoute a chaque image (22 a 110, selon la cadence de tir la plus
-- haute du credit).
-- 2026-11-08 soir (sortie) : score 32 bits en deux mots (0x166C fort, 0x166E faible), lignes SCORE_STATE
-- parasites retirees (0x1677, 0xA6B5, 0x10C4C), CREDITS en 0x00AD, DIP retires du bloc lives (0x0039, 0x0036),
-- vies a max=1 (une demo finie ou coupee par une piece fait 2 -> 0), player= sur chaque ligne.
-- mem-curator v5.0.0 (2026-07-12) profile=wrapper
return {
  game = {
    title = "Battle Garegga",
    system = "arcade",
    system_name = "Arcade",
    genre = "Unknown"
  },

  rom = {
    name = "battle-garegga",
    hashes = {
      { hash = "c0830de50cdf83cbe0f5e44e70c7dbf9", label = "bgaregga.7z <Battle Garegga (Europe / USA / Japan / Asia) (Sat Feb 3 1996)>" },

      points = {
        { address=0X3FAE, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 1, BCD digits 5 to 8 (value * 10000)" },
        { address=0X3FB0, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 1, BCD digits 1 to 4 (value * 1)" },
        { address=0X3FB2, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 2, BCD digits 5 to 8 (value * 10000)" },
        { address=0X3FB4, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 2, BCD digits 1 to 4 (value * 1)" },
        { address=0X3FB6, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 3, BCD digits 5 to 8 (value * 10000)" },
        { address=0X3FB8, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 3, BCD digits 1 to 4 (value * 1)" },
        { address=0X3FBA, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 4, BCD digits 5 to 8 (value * 10000)" },
        { address=0X3FBC, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 4, BCD digits 1 to 4 (value * 1)" },
        { address=0X3FBE, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 5, BCD digits 5 to 8 (value * 10000)" },
        { address=0X3FC0, type="u16le", condition="change", action="SCORE_STATE", player=1, score_kind="game", score_encoding="bcd", desc="Player 1 score of stage 5, BCD digits 1 to 4 (value * 1)" },
      },
    },
    world_interaction = {
      objects = {
        { address=0X5A3A, type="u8", condition="change", action="OBJECT_INTERACTION", player=1, desc="P1 bombs in stock (3 at start)" },
        { address=0X52C8, type="u8", condition="change", action="OBJECT_INTERACTION", desc="Base rank (0 to 63): stage minimum plus bombs, lives and power-ups in stock" },
        { address=0X6C3C, type="u16le", condition="change", mask=0XFFF0, action="OBJECT_INTERACTION", player=1, desc="P1 cyborg chain (1 to 999), every 16 (mask); back to 1 when a cyborg escapes" },
        { address=0X6C3E, type="u16le", condition="change", mask=0XFFF0, action="OBJECT_INTERACTION", player=1, desc="P1 cyborgs collected in this stage, every 16 (mask)" },
        { address=0X402A, type="u16le", condition="change", mask=0XFFF0, action="OBJECT_INTERACTION", player=1, desc="P1 cyborgs collected in the game (extend item at 2000), every 16 (mask)" },
        { address=0X5110, type="u16le", condition="change", mask=0XFFF0, action="OBJECT_INTERACTION", desc="Cyborgs missed in the game (aimed bullets speed up), every 16 (mask)" },
        { address=0X5A40, type="u8", condition="change", action="OBJECT_INTERACTION", player=1, desc="P1 power, first part (0 to 5)" },
        { address=0X5A44, type="u8", condition="change", action="OBJECT_INTERACTION", player=1, desc="P1 power, second part (0 to 4)" },

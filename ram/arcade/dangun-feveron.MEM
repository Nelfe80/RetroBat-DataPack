-- 2026-11-11 : score = somme des scores des 5 stages (le jeu garde un score par stage, deux mots BCD chacun a partir de
-- 0x3FAE, et ne verse le total qu a la fin du stage) ; credits 0x1730 (+1 par piece, -1 au START) ; vies 0x52C4 (3 au
-- depart) ; stage 0x52D8 (0 a 4) ; bombes 0x5A3A. Mesures sous FBNeo (dfeveron).
-- 2026-11-11 (Player Deck) : rank de base 0x52C8, chaine de cyborgs 0x6C3C, cyborgs du stage 0x6C3E et de la partie
-- 0x402A, cyborgs manques 0x5110, puissance 0x5A40 et 0x5A44, barre de vie du boss 0x5198 (pixels). Lignes d affichage
-- seulement (OBJECT_INTERACTION), hors score ; mask = lecture par paliers (jamais a chaque image).
-- mem-curator v5.0.0 (2026-07-12) profile=wrapper
return {
  game = {
    title = "Dangun Feveron",
    system = "arcade",
    system_name = "Arcade",
    genre = "Shoot'em Up"
  },

  rom = {
    name = "dangun-feveron",
    hashes = {
      { hash = "3c253b5326dcad0dfc09a0bb60686108", label = "dfeveron.zip" },
    }
  },


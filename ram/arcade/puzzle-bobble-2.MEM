        { address=0X3034, type="u8", condition="change", action="CREDITS_SCREEN", desc="Credits: last digit is unit" },
        { address=0X3038, type="u32le", condition="change", action="CREDITS_SCREEN", desc="Credits: last number is tens" },
      },

-- ESP Ra.De. : le SENS des signaux de esp-ra-de.MEM pour l'affichage.
-- Lu par APIExpose et le PlayerDeck seulement. Ne declare aucune adresse : chaque signal cite des lignes du .MEM.
-- N'entre ni dans le score ni dans l'empreinte certifiee. Preuves : mesures au banc FBNeo sans ecran.
-- Format : .SMEM, schema 1. Identifiants du vocabulaire standard du .SMEM.
return {
  schema = 1,
  kind = "semantics",
  version = 4,
  game = { system = "arcade", slug = "esp-ra-de", title = "ESP Ra.De." },
  mem = { file = "esp-ra-de.MEM" },

  signals = {
    { id = "stage", kind = "counter", label = "Stage", short = "STAGE",
      from = { { address = 0X25A6, action = "PROGRESSION_STAGE" } },
      min = 0, max = 5, quality = "qualified",
      proof = "0 au stage 1, 1 au debut du stage 2 (32 190), 2 au debut du stage 3 (51 300), banc avec captures" },
    { id = "stage.progress", kind = "counter", unit = "step", label = "Stage progress", short = "DIST",
      from = { { address = 0X257C, action = "OBJECT_INTERACTION" } },
      min = -41, max = 860, quality = "qualified",
      proof = "action : compteur de pas de defilement, monotone sur les 6 stages (de -41 au depart, 0 au stage 1), repart du depart a chaque stage, s'arrete a l'arrivee du boss (d 468, 508, 700, 858, 448, 428) ; mesure du defilement du decor 8,001 px par pas sur le stage 1. Publie par blocs de 16 pas (mask 0XFFF0), vivante au simulateur d'auto-mute"},
    { id = "players.1.lives", player = 1, kind = "counter", unit = "ship", label = "Lives", short = "SHIP",
      from = { { address = 0X254E, action = "LOSE_LIFE" }, { address = 0X254E, action = "GAIN_LIFE" } },
      min = 0, max = 9, initial = 3, quality = "qualified",
      proof = "3 au depart, -1 par mort, 0 a l'ecran CONTINUE (deathsignal propre : 3, 2, 1, 0)" },

    { id = "players.1.power.level", player = 1, kind = "gauge", label = "Power", short = "POW",
      from = { { address = 0X272A, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 4, initial = 0, quality = "qualified",
      proof = "0 -> 4 aux prises ; posee a 0 : tir fin, a 4 : flot large" },
    { id = "players.1.item.count", player = 1, kind = "counter", label = "Item counter", short = "ITEMS",
      from = { { address = 0X26F8, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 9999, initial = 0, quality = "qualified",
      proof = "posee a 150 puis 77 : 150 et 77 affiches par le jeu ; +1 par item pris. Publie par pas de 32 (mask)" },
    { id = "players.1.game.esp_ra_de.item_max", player = 1, kind = "counter", label = "Item counter maximum", short = "MAX",
      from = { { address = 0X2704, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 9999, initial = 200, quality = "partial",
      proof = "200 en debut de partie ; +100 a chaque vidange (guides publics), hausse non vue au banc" },
    { id = "players.1.game.esp_ra_de.barrier", player = 1, kind = "gauge", label = "Guard barrier", short = "BARRIER",
      from = { { address = 0X2750, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 4000, initial = 4000, quality = "qualified",
      proof = "posee a 1000, 3000, 4000 : la jauge du jeu suit ; bouton de la barriere tenu : 4000 -> 2780. Publiee par pas de 256 (mask)" },

    { id = "players.1.multiplier", player = 1, kind = "level", label = "Chain multiplier", short = "MULT",
      from = { { address = 0X26FE, action = "OBJECT_INTERACTION", player = 1 } },
      values = {
        { raw = 0, value = 1, label = "1" },
        { raw = 1, value = 2, label = "2" },
        { raw = 2, value = 3, label = "3" },
        { raw = 3, value = 4, label = "4" },
        { raw = 4, value = 5, label = "5" },
        { raw = 5, value = 6, label = "6" },
        { raw = 6, value = 7, label = "7" },
        { raw = 7, value = 8, label = "8" },
        { raw = 8, value = 9, label = "9" },
        { raw = 9, value = 10, label = "10" },
        { raw = 10, value = 11, label = "11" },
        { raw = 11, value = 12, label = "12" },
        { raw = 12, value = 13, label = "13" },
        { raw = 13, value = 14, label = "14" },
        { raw = 14, value = 15, label = "15" },
        { raw = 15, value = 16, label = "16" },
      },
      min = 1, max = 16, initial = 1, quality = "qualified",
      proof = "ecriture : posee a 3, 7, 15 (minuterie 2 tenue), le score d'un meme passage est multiplie par 3,2 ; 6,1 ; 12 ; sans minuterie (0) l'octet reste mais le score ne bouge plus (x1). Replay reel : l'octet passe a 3 avec la minuterie a 69 au premier gros enchainement"},
    { id = "players.1.item.timer", player = 1, kind = "counter", unit = "frame", label = "Chain timer", short = "TIME",
      from = { { address = 0X26FC, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 255, initial = 0, quality = "qualified",
      proof = "ecriture : posee a 120, decompte d'une unite par image jusqu'a 0, le multiplicateur ne compte que pendant ce temps. Replay reel : 69 au depart d'une chaine, decompte jusqu'a 0 (le multiplicateur retombe 30 images plus tard). Publie par pas de 32 (mask)" },
    { id = "players.1.game.esp_ra_de.barrier_charge", player = 1, kind = "gauge", label = "Guard barrier charge", short = "CHARGE",
      from = { { address = 0X274E, action = "OBJECT_INTERACTION", player = 1 } },
      min = 0, max = 4352, initial = 0, quality = "qualified",
      proof = "bouton de la barriere tenu : monte jusqu'a 4352 (laser au relachement), retombe a 0 ; releve du 11/11 (0 a 1361) et du 20/11 (4189 et 4352). Publiee par pas de 256 (mask)" },
    { id = "game.playing", kind = "flag", label = "In game", short = "PLAY",
      from = { { address = 0X240A, action = "OBJECT_INTERACTION" } },
      values = { { raw = 7, value = 1, label = "Playing" }, { min = 0, max = 6, value = 0, label = "Not playing" }, { min = 8, max = 255, value = 0, label = "Not playing" } },
      min = 0, max = 1, initial = 0, quality = "qualified",
      proof = "banc FBNeo sans ecran, 20/11 : 0x240A = 7 pendant la partie (y compris PLEASE WAIT), 8 a l ecran CONTINUE (compte a rebours 9), 11 au choix du personnage, 5 en demo, 4 au titre, 13/12/1 a l attract ; les vies 0x254E valent 3 en demo" },
    { id = "game.continue", kind = "flag", label = "Continue screen", short = "CONT",
      from = { { address = 0X240A, action = "OBJECT_INTERACTION" } },
      values = { { raw = 8, value = 1, label = "Continue" }, { min = 0, max = 7, value = 0, label = "Other" }, { min = 9, max = 255, value = 0, label = "Other" } },
      min = 0, max = 1, initial = 0, quality = "qualified",
      proof = "banc FBNeo sans ecran, 20/11 : 0x240A = 7 pendant la partie (y compris PLEASE WAIT), 8 a l ecran CONTINUE (compte a rebours 9), 11 au choix du personnage, 5 en demo, 4 au titre, 13/12/1 a l attract ; les vies 0x254E valent 3 en demo" },
  },
}

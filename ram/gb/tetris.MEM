-- mem-curator v5.0.0 (2026-07-12) profile=wrapper
-- .user 2026-09-29 : score reduit a sa seule ligne (les tables de records sortent), fin de partie posee.
-- .user 2026-09-29 (3) : demo (0xFFE4) et debut de partie humaine (ecran du niveau) : les parties lancees par A comptent.
-- .user 2026-09-29 (2) : mode (type A / type B) et difficulte de depart (niveau, hauteur) pour les
--   classements par mode. Une ligne « eq » par valeur : une ligne « change » que le joueur fait
--   defiler vite (8 changements a moins de 20 images) serait coupee pour la session par le wrapper.
return {
  game = {
    title = "Tetris",
    system = "gb",
    system_name = "Game Boy",
    genre = "Puzzle"
  },

  rom = {
    name = "tetris",
    hashes = {
      { hash = "084f1e457749cdec86183189bd88ce69", label = "Tetris (Japan) (En).gb" },
      { hash = "982ed5d2b12a0377eb14bcdc4123744e", label = "Tetris (World) (Rev 1).gb" },
      { hash = "d1feeed857f9010980b00bf53f749d61", label = "Tetris (World) (Rev1) (Pt) (v1.1).gb" },
    }
  },

  events = {
    flow = {
      lifecycle = {
        { address=0XFFAB, type="u8", condition="change", action="PAUSE_ON", desc="01:Pause" },
        -- 0xFFE1, le mode d'ecran : 0x0D = fin de partie (a confirmer en jeu).
        { address=0XFFE1, type="u8", condition="eq", value=0X0D, action="GAME_OVER", desc="Screen mode 0x0D: game over" },
        -- La demo joue comme un joueur (0xFFE1 = 0x00, et elle marque des points) : 0xFFE4 porte
        -- le numero de la demo (2 type A, 1 type B), 0 hors demo. Verifie sous MAME le 2026-09-29.
        { address=0XFFE4, type="u8", condition="eq", value=0X01, action="DEMO_MODE", desc="Demo B-type" },
        { address=0XFFE4, type="u8", condition="eq", value=0X02, action="DEMO_MODE", desc="Demo A-type" },
        -- Une partie humaine commence : l'ecran du choix du niveau (0x11 type A, 0x13 type B), que la
        -- demo ne traverse jamais. Tetris se lance par START ou par A : START seul ne suffit pas.
        { address=0XFFE1, type="u8", condition="eq", value=0X11, action="GAME_START", desc="Level select A-type" },
        { address=0XFFE1, type="u8", condition="eq", value=0X13, action="GAME_START", desc="Level select B-type" },
      },
    },
    game_mode = {
      -- 0xFFC0, le type de partie choisi au menu : 0x37 type A, 0x77 type B (verifie sous MAME).
      mode = {
        { address=0XFFC0, type="u8", condition="eq", value=0X37, action="GAME_MODE", desc="Game type A" },
        { address=0XFFC0, type="u8", condition="eq", value=0X77, action="GAME_MODE", desc="Game type B" },
      },
      -- Le niveau de depart du type A (0xFFC2, 0 a 9), le niveau (0xFFC3, 0 a 9) et la hauteur
      -- (0xFFC4, 0 a 5) du type B. Choisis au menu, ils ne bougent plus en jeu.
      difficulty = {
        { address=0XFFC2, type="u8", condition="eq", value=0X00, action="GAME_DIFFICULTY", desc="Type A start level 0" },
        { address=0XFFC2, type="u8", condition="eq", value=0X01, action="GAME_DIFFICULTY", desc="Type A start level 1" },
        { address=0XFFC2, type="u8", condition="eq", value=0X02, action="GAME_DIFFICULTY", desc="Type A start level 2" },
        { address=0XFFC2, type="u8", condition="eq", value=0X03, action="GAME_DIFFICULTY", desc="Type A start level 3" },
        { address=0XFFC2, type="u8", condition="eq", value=0X04, action="GAME_DIFFICULTY", desc="Type A start level 4" },
        { address=0XFFC2, type="u8", condition="eq", value=0X05, action="GAME_DIFFICULTY", desc="Type A start level 5" },
        { address=0XFFC2, type="u8", condition="eq", value=0X06, action="GAME_DIFFICULTY", desc="Type A start level 6" },
        { address=0XFFC2, type="u8", condition="eq", value=0X07, action="GAME_DIFFICULTY", desc="Type A start level 7" },
        { address=0XFFC2, type="u8", condition="eq", value=0X08, action="GAME_DIFFICULTY", desc="Type A start level 8" },
        { address=0XFFC2, type="u8", condition="eq", value=0X09, action="GAME_DIFFICULTY", desc="Type A start level 9" },
        { address=0XFFC3, type="u8", condition="eq", value=0X00, action="GAME_DIFFICULTY", desc="Type B level 0" },
        { address=0XFFC3, type="u8", condition="eq", value=0X01, action="GAME_DIFFICULTY", desc="Type B level 1" },
        { address=0XFFC3, type="u8", condition="eq", value=0X02, action="GAME_DIFFICULTY", desc="Type B level 2" },
        { address=0XFFC3, type="u8", condition="eq", value=0X03, action="GAME_DIFFICULTY", desc="Type B level 3" },
        { address=0XFFC3, type="u8", condition="eq", value=0X04, action="GAME_DIFFICULTY", desc="Type B level 4" },
        { address=0XFFC3, type="u8", condition="eq", value=0X05, action="GAME_DIFFICULTY", desc="Type B level 5" },
        { address=0XFFC3, type="u8", condition="eq", value=0X06, action="GAME_DIFFICULTY", desc="Type B level 6" },
        { address=0XFFC3, type="u8", condition="eq", value=0X07, action="GAME_DIFFICULTY", desc="Type B level 7" },
        { address=0XFFC3, type="u8", condition="eq", value=0X08, action="GAME_DIFFICULTY", desc="Type B level 8" },
        { address=0XFFC3, type="u8", condition="eq", value=0X09, action="GAME_DIFFICULTY", desc="Type B level 9" },
        { address=0XFFC4, type="u8", condition="eq", value=0X00, action="GAME_DIFFICULTY", desc="Type B high 0" },
        { address=0XFFC4, type="u8", condition="eq", value=0X01, action="GAME_DIFFICULTY", desc="Type B high 1" },
        { address=0XFFC4, type="u8", condition="eq", value=0X02, action="GAME_DIFFICULTY", desc="Type B high 2" },
        { address=0XFFC4, type="u8", condition="eq", value=0X03, action="GAME_DIFFICULTY", desc="Type B high 3" },
        { address=0XFFC4, type="u8", condition="eq", value=0X04, action="GAME_DIFFICULTY", desc="Type B high 4" },
        { address=0XFFC4, type="u8", condition="eq", value=0X05, action="GAME_DIFFICULTY", desc="Type B high 5" },
      },
    },
    progression = {
      level = {
        { address=0XFF9E, type="u16le", condition="change", action="LEVEL_CLEAR", desc="Number of lines cleared (BCD)" },
        { address=0XFFA9, type="u8", condition="change", action="NEW_LEVEL", desc="8-bit - Current Level" },
      },
    },
    inventory = {
      items = {
        { address=0XC0C5, type="u8", condition="change", action="INVENTORY_ITEM", desc="modeb_score_sheet_item" },
      },
    },
    scoring = {
      points = {
        -- Le score courant : 3 octets BCD, poids faible en tete (0xC0A0 = 000,0XX ; 0xC0A1 = 00X,X00 ;
        -- 0xC0A2 = XX0,000). Six chiffres, 999 999 au plus.
        { address=0XC0A0, type="u24le", condition="change", action="SCORE_STATE", score_kind="game", score_encoding="bcd", desc="Player 1 score BCD" },
      },
    },
    world_interaction = {
      objects = {
        { address=0XFFA0, type="u8", condition="change", action="OBJECT_INTERACTION", desc="Block Coordinates" },
      },
    },
    system = {
      timer = {
        { address=0XFF99, type="u8", condition="change", action="GENERAL_TIMER", timer_kind="game", timer_role="unknown", timer_direction="unknown", timer_unit="unknown", desc="Tetris piece Drop counter" },
      },
    },
  },
}

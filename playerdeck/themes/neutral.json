    "layout": "two-rails",
    "stages": [],
    "words": { "stock": "LIVES", "special": "BOMBS", "boss": "BOSS", "fire": "PRESS RATE", "graph": "SCORE RATE" },
    "controls": [
      { "id": "b", "label": "B" }, { "id": "a", "label": "A" }, { "id": "y", "label": "Y" }, { "id": "x", "label": "X" }, { "id": "start", "label": "START" }
    ],
    "fire": "b",
    "bindings": {},
    "left": ["header", "score", "stages", "controller"],
    "right": ["graph", "stock", "special", "fire", "context"]

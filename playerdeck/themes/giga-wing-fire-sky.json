 "native": {
  "width": 384,
  "height": 224,
  "scaling": "nearest",
  "note": "Giga Wing as the core gives it (CPS-2, 384 x 224 shown 4:3, game pixels taller than wide). 1920 x 1080: game 1440 x 1080 pushed right, rail 480 px = 128 game pixels; 1920 x 1200: game 1600 x 1200, rail 320 px = 76 game pixels = 153 Deck pixels. The Deck pixel is the game pixel while the rail holds its plates in full form, half the game pixel otherwise (deckPixel auto), each game pixel cut in 2 x 2 Deck pixels on the same grid. The rail is always filled: plates in reserve come back when there is room (recipe.fit), the rest is shared between the rows. Quarter pixel (deckPixel quarter, v3): the rail holds score, rank, stages, medals, ship stock and controller only at that scale, with the small texts at 24 (3 Deck pixels per font pixel, 75% of the size at the game pixel) and a line gap of 5; at the half pixel two plates would have to go.",
  "deckPixel": "quarter",
  "deckPixelMax": 4
 },
 "placement": {
  "anchor": "right",
  "railMin": 56,
  "note": "Game pushed right at full screen height (no black band), the rail takes the width left on the left."
 },

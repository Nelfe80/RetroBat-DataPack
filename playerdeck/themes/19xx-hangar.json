      "drop": ["controller", "stages", "context", "shot", "boss", "fire", "stock", "special", "firemix", "nomiss", "graph", "score", "rank"],
      "note": "Trial layer: the trial plates go after the header on the left rail. An instrument yields only when the rules lock its value. When a rail is too short, instruments give way in the order of drop: what the trial does not need first, then FIRE MIX, NO MISS, SCORE RATE, then the score, LIVE RANK last (the trial plates never)."
    },
    "right": ["stock|special", "rank", "shot", "boss", "graph", "fire", "firemix"]

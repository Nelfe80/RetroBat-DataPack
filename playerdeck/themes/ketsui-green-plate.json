 "native": {
  "width": 224,
  "height": 448,
  "rowUnit": 2,
  "scaling": "nearest",
  "note": "Ketsui vertical as the core gives it (448 x 224 turned, shown 3:4, game pixels twice as wide as tall). Like the game's own 8 x 16 text, each canvas row is 2 game lines (rowUnit 2): the canvas is 224 x 224. 1920 x 1080: game 810 x 1080, rails of 153 game pixels; 1920 x 1200: game 900 x 1200, rails of 127 game pixels. The rail is always filled: plates in reserve come back when there is room (recipe.fit), the rest is shared between the rows. Deck pixel auto (H-D25): the game pixel while every plate fits, half a pixel otherwise (fonts of skin.half doubled, icons and controller zoomed), a quarter only if needed (this game is rich in signals); the controller always stays.",
  "deckPixel": "auto"
 },
 "placement": {
  "anchor": "center",
  "note": "Game in the middle at full screen height, a rail on each side."
 },

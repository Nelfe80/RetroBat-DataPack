msgid "Controls games with multiple screens or display outputs."
msgstr "Steruje grami z kilkoma ekranami lub wyjściami obrazu."

msgctxt "game_options"
msgid "Keeps only games where a second screen is used for gameplay when set to ONLY."
msgstr "Przy TYLKO zostawia tylko gry, w których drugi ekran służy do grania."


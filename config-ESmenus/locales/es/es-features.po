msgid "DMD AUTOGEN"
msgstr "DMD AUTOMÁTICO"

msgctxt "game_options"
msgid "Generates a system or game DMD image when no dmd.png exists, using the selected target matrix size."
msgstr "Genera una imagen DMD de sistema o de juego cuando no existe dmd.png, con el tamaño de matriz elegido."


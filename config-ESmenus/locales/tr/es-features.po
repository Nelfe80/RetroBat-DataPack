msgstr "MEYDAN OKUMALARIMI CANLI YAYINLA"

msgctxt "game_options"
msgid "A challenge started from the leaderboard is broadcast as a live session on NelfePlay, like the Share live option on the website."
msgstr "Siralamadan baslatilan bir meydan okuma, sitedeki Canli yayinla secenegi gibi NelfePlay'de canli yayinlanir."

msgctxt "game_options"
msgid "WHO CAN JOIN MY CHALLENGES"
msgstr "MEYDAN OKUMALARIMA KIM KATILABILIR"

msgctxt "game_options"
msgid "Who may join a broadcast challenge. Nobody means viewers can only watch."
msgstr "Yayinlanan bir meydan okumaya kim katilabilir. Kimse: izleyiciler yalnizca izleyebilir."

msgctxt "game_options"
msgid "NOBODY"
msgstr "KIMSE"


msgstr "KASTINSTELLINGEN"

msgctxt "game_options"
msgid "OFFICIAL GAMES"
msgstr "OFFICIELE SPELLEN"

msgctxt "game_options"
msgid "Controls standard official games and clones without special tags, so special categories can be isolated."
msgstr "Beheert standaard officiele spellen en clones zonder speciale tags, zodat speciale categorieen kunnen worden geisoleerd."

msgctxt "game_options"
msgid "global.apiexpose.romset.official_games_mode"
msgstr "global.apiexpose.romset.official_games_mode"


msgid "MATCH ROM REGION"
msgstr "ROM-REGIO MATCHEN"

msgid "CONTENT REGION PROFILE"
msgstr "CONTENTREGIOPROFIEL"

msgid "INTERFACE LANGUAGE"
msgstr "INTERFACETAAL"

msgid "LOGO / WHEEL LOCALIZATION"
msgstr "LOGO / WHEEL-LOKALISATIE"

msgid "USER LANGUAGE"
msgstr "GEBRUIKERSTAAL"

msgid "Controls localized original media selection. By default, APIExpose tries the ROM region first, then safe readable fallbacks."
msgstr "Beheert selectie van gelokaliseerde originele media. Standaard probeert APIExpose eerst de ROM-regio en daarna veilige leesbare alternatieven."

msgid "Controls whether logos and wheels favor user-readable language or the original ROM region."
msgstr "Bepaalt of logos en wheels de door de gebruiker leesbare taal of de oorspronkelijke ROM-regio verkiezen."

msgid "global.apiexpose.media_allocation.logo_region_mode"
msgstr "global.apiexpose.media_allocation.logo_region_mode"

msgid "SCRAPE EXACT LOCAL MEDIA"
msgstr "EXACTE LOKALE MEDIA SCRAPEN"

msgid "Scrapes the exact prioritized regional media when a visible slot is only satisfied by a local fallback."
msgstr "Scrapet de exacte regionale media met prioriteit wanneer een zichtbare slot alleen door een lokaal alternatief wordt gevuld."

msgid "global.apiexpose.scraping.exact_local_media.enabled"
msgstr "global.apiexpose.scraping.exact_local_media.enabled"

msgctxt "game_options"
msgid "REPAIR GAMELISTS ON STARTUP"
msgstr "GAMELISTS HERSTELLEN BIJ START"

msgctxt "game_options"
msgid "Runs the startup pass that realigns visible gamelist media slots and localized text metadata. Manual reallocations still work when disabled."
msgstr "Voert bij het opstarten de ronde uit die de zichtbare mediavakken van de gamelist en de gelokaliseerde teksten opnieuw uitlijnt. Handmatige toewijzingen blijven werken als dit uit staat."

msgctxt "game_options"
msgid "global.apiexpose.api.repair_gamelists_on_startup"
msgstr "global.apiexpose.api.repair_gamelists_on_startup"
msgctxt "game_options"
msgid "SYNC GAMELISTS WITH SYSTEM LANGUAGE"
msgstr "GAMELISTS SYNCHRONISEREN MET SYSTEEMTAAL"

msgctxt "game_options"
msgid "When the EmulationStation system language changes, APIExpose updates gamelists with localized metadata for the new language."
msgstr "Wanneer de systeemtaal van EmulationStation verandert, werkt APIExpose gamelists bij met gelokaliseerde metadata voor de nieuwe taal."

msgctxt "game_options"
msgid "global.apiexpose.api.sync_gamelists_with_system_language"
msgstr "global.apiexpose.api.sync_gamelists_with_system_language"


msgctxt "game_options"
msgid "UNKNOWN ROMS"
msgstr "ONBEKENDE ROMS"

msgid "Controls ROM entries that cannot be matched to local Roms Manager data and do not have useful scraped metadata."
msgstr "Beheert ROM-items die niet overeenkomen met lokale Roms Manager-gegevens en geen bruikbare scrape-metadata hebben."

msgctxt "game_options"
msgid "MARQUEE AUTOGEN"
msgstr "MARQUEE AUTOMATISCH GENEREREN"


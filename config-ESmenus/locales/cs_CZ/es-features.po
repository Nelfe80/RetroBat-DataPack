msgstr "SYNCHRONIZOVAT GAMELISTY S JAZYKEM SYSTEMU"

msgctxt "game_options"
msgid "When the EmulationStation system language changes, APIExpose updates gamelists with localized metadata for the new language."
msgstr "Kdyz se zmeni systemovy jazyk EmulationStation, APIExpose aktualizuje gamelisty lokalizovanymi metadaty pro novy jazyk."

msgctxt "game_options"
